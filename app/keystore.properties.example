# Copy to app/keystore.properties (gitignored) and fill in. Never commit the real file or the .jks keystores.
# Create the keystores first: see "Building and releasing" in CONTRIBUTING.md.

# apk.*: signs the free APK published on GitHub. This key is permanent: back it up.
apk.storeFile=/home/you/keystores/muxalot-apk.jks
apk.storePassword=CHANGE_ME
apk.keyAlias=apk
apk.keyPassword=CHANGE_ME

# play.*: upload key for the pro bundle on Google Play (Play App Signing holds the real signing key).
play.storeFile=/home/you/keystores/muxalot-play.jks
play.storePassword=CHANGE_ME
play.keyAlias=play
play.keyPassword=CHANGE_ME
